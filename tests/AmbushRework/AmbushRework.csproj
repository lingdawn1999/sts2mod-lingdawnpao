<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>../../.godot/ambush-tests/bin/</BaseOutputPath>
    <BetaGameReference Condition="'$(BetaGameReference)' == ''">../../.godot/ambush-tests/runtime-beta/sts2.dll</BetaGameReference>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="lingdawnpao" HintPath="../../.godot/mono/temp/bin/Debug/lingdawnpao.dll" />
    <Reference Include="0Harmony" HintPath="../../libs/0Harmony.dll" />
    <Reference Include="sts2" HintPath="../../libs/sts2.dll" Condition="'$(Sts2Ref)' != 'beta'" />
    <Reference Include="sts2" HintPath="$(BetaGameReference)" Condition="'$(Sts2Ref)' == 'beta'" />
    <Reference Include="GodotSharp" HintPath="../../.godot/mono/temp/bin/Debug/GodotSharp.dll" />
    <Reference Include="System.IO.Hashing" HintPath="$(NuGetPackageRoot)/system.io.hashing/9.0.0/lib/net9.0/System.IO.Hashing.dll" Condition="'$(Sts2Ref)' == 'beta'" />
  </ItemGroup>
  <!-- The runtime asset must be named sts2.dll: the beta file has that assembly
       identity too, and a beta filename in deps.json does not satisfy its bind. -->
  <Target Name="PrepareBetaGameReference" BeforeTargets="ResolveAssemblyReferences" Condition="'$(Sts2Ref)' == 'beta' and '$(BetaGameReference)' == '../../.godot/ambush-tests/runtime-beta/sts2.dll'">
    <MakeDir Directories="../../.godot/ambush-tests/runtime-beta" />
    <Copy SourceFiles="../../libs/sts2.beta.dll" DestinationFiles="../../.godot/ambush-tests/runtime-beta/sts2.dll" />
  </Target>
</Project>
